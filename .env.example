# Content source. Leave SANITY_PROJECT_ID empty to build from content/seed.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Viewer token: only needed if the dataset is private.
SANITY_READ_TOKEN=
# Editor token: only for `npm run studio:seed` (one-off import).
SANITY_WRITE_TOKEN=

# Studio (studio/.env)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Production domain (canonicals, sitemap, JSON-LD). To be confirmed by the client.
SITE_URL=https://www.floraconcept.fr
# Google Tag Manager container, loaded only after consent. Empty = no analytics.
GTM_ID=

# Keep client placeholders visible as « À fournir » chips (review builds only).
CONTENT_PREVIEW=0
# Override "now" for the blog publication filter (tests).
# BUILD_NOW=2026-11-05T06:00:00Z

# Quote form on Vercel (web/api/devis.mjs)
DEVIS_ALLOWED_ORIGINS=https://www.floraconcept.fr
DEVIS_TO_PACA=
DEVIS_TO_IDF=
DEVIS_TO_DEFAULT=
DEVIS_FROM=Flora Concept <no-reply@floraconcept.fr>
RESEND_API_KEY=
DEVIS_ACK_SUBJECT=
DEVIS_ACK_BODY=
DEVIS_IP_SALT=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
