        {
          "_key": "92cfceb39d57",
          "lead": "Des jardiniers salariés",
          "text": [
            {
              "_type": "block",
              "_key": "fb644351560d",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "0286dd552c9b",
                  "text": "l'installation et l'entretien sont réalisés par nos équipes, pas par des sous-traitants anonymes. ",
                  "marks": []
