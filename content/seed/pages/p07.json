      "items": [
        {
          "_key": "ec2b67d54675",
          "question": "À quelle fréquence les fleurs sont-elles renouvelées ?",
          "answer": [
            {
              "_type": "block",
              "_key": "264c3f3470ca",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "3977dced04b7",
                  "text": "La fréquence est choisie au contrat selon vos emplacements et votre budget. Chaque livraison comprend la mise en place de la nouvelle composition et la reprise de la précédente. ",
                  "marks": []
                },
                {
                  "_type": "pending",
                  "_key": "e3e097dc79d8",
                  "note": "fréquences exactes proposées"
                }
              ]
            }
          ]
        },
        {
          "_key": "5e5ad0b76c76",
          "question": "Peut-on choisir le style des compositions ?",
          "answer": [
            {
              "_type": "block",
              "_key": "7ed28031fea3",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "cf06ed6df6eb",
                  "text": "Oui. Le style est défini au départ avec vous (classique, contemporain, exotique, couleurs de votre charte) et nos compositions suivent ensuite les saisons dans ce cadre. Vous pouvez le faire évoluer à tout moment.",
                  "marks": []
                }
              ]
            }
          ]
        },
        {
          "_key": "1625434cebb5",
          "question": "Livrez-vous les fleurs partout en France ?",
          "answer": [
            {
              "_type": "block",
              "_key": "8665243ef242",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "6e75d23a0574",
                  "text": "Le service floral est assuré en Île-de-France et en Provence-Alpes-Côte d'Azur. ",
                  "marks": []
                },
                {
                  "_type": "pending",
                  "_key": "38c07d9eb6f5",
                  "note": "confirmer la zone exacte de livraison florale par agence"
                }
              ]
            }
          ]
        },
