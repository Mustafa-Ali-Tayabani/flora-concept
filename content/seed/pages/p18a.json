              "_type": "block",
              "_key": "081be7c370bf",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "eeb8f1dbcd3e",
                  "text": "nos jardiniers sont salariés, la résidence est suivie par la même équipe d'une année sur l'autre.",
                  "marks": []
                }
              ]
            }
          ]
        }
      ],
      "note": [
        {
          "_type": "block",
          "_key": "23e24d90c697",
          "style": "normal",
          "markDefs": [],
          "children": [
            {
              "_type": "span",
              "_key": "91d5e6728240",
