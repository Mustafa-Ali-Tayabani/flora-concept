      "items": [
        {
          "_key": "fbaacb960902",
          "lead": "Un interlocuteur unique",
          "text": [
            {
              "_type": "block",
              "_key": "1592af7e76a7",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "cedf5ccd8253",
                  "text": "pour toutes vos résidences en PACA, joignable directement.",
                  "marks": []
                }
              ]
            }
          ]
        },
        {
          "_key": "784e92401558",
          "lead": "Une proposition prête pour l'assemblée générale",
          "text": [
            {
              "_type": "block",
              "_key": "cf7579954ba3",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "00fd4b4549a1",
                  "text": "périmètre, planning, tarif annuel, sans surprise en cours d'année.",
                  "marks": []
                }
              ]
            }
          ]
        },
        {
          "_key": "ff33a8f10515",
          "lead": "Des comptes rendus par passage",
          "text": [
            {
              "_type": "block",
              "_key": "e83f7664870c",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "5bbd5046c9b4",
                  "text": "pour répondre aux copropriétaires et au conseil syndical sans vous déplacer.",
                  "marks": []
                }
              ]
            }
          ]
        },
        {
          "_key": "2e5a616a2cb3",
          "lead": "Des interventions silencieuses",
          "text": [
